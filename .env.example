# Model provider contract. Copy to .env (gitignored) and paste your API key
# into MODEL_API_KEY. Swapping models is exactly these three values, no code
# change.

# Default route: GLM-5.3 via OpenRouter.
MODEL=z-ai/glm-5.3
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=

# --- alternate route for the same model (edit the 3 above to switch) ---
# Z.ai direct:  MODEL=glm-5.3   MODEL_BASE_URL=https://api.z.ai/api/paas/v4
