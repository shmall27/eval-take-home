# Model provider contract. Copy to .env (gitignored) and fill in the key.
# Swapping models is exactly these three values, no code change.

# 1. Model string, as the provider names it.
MODEL=glm-5.3
# 2. Base URL of an OpenAI-compatible /chat/completions endpoint.
MODEL_BASE_URL=https://api.z.ai/api/paas/v4
# 3. API key.
MODEL_API_KEY=

# --- alternate routes for the same open-weight model (swap by editing the 3 above) ---
# OpenRouter: MODEL=z-ai/glm-5.3   MODEL_BASE_URL=https://openrouter.ai/api/v1
# A second, smaller endpoint for the zero-code-change swap demo goes here too.
