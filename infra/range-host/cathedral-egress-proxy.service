[Unit]
Description=Cathedral range egress proxy (allowlisted, logged)

[Service]
ExecStart=/usr/bin/python3 %h/cathedral/egress_proxy.py --listen 10.77.0.1:3128 --clients 10.77.0.0/24 --allowlist %h/cathedral/egress-allowlist.txt --log %h/cathedral/egress.log
# The bridge address only exists once LXD has brought up cathbr0.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
