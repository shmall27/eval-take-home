# Model provider contract. Copy to .env (gitignored) and fill in the key via
# `bb secret request MODEL_API_KEY --write-env .env`. Swapping models is exactly
# these three values, no code change.

# Validated route (2026-10-01): GLM-5.3 via OpenRouter.
MODEL=z-ai/glm-5.3
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=

# --- alternate route for the same model (edit the 3 above to switch) ---
# Z.ai direct:  MODEL=glm-5.3   MODEL_BASE_URL=https://api.z.ai/api/paas/v4
# A second, smaller endpoint for the zero-code-change swap demo goes here too.
